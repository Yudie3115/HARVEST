# Database
DATABASE_URL=postgresql://postgresql:postgresql@localhost:5432/postharvest_scraper
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=postharvest-documents
MINIO_SECURE=false

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=postharvest_knowledge

LLM_PROVIDER=openai
# LLM_PROVIDER=ollama  # Only if needed

# OpenAI (Primary - Default)
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Ollama LLM (Optional Fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TEMPERATURE=0.1
OLLAMA_MAX_TOKENS=2048

# Embedding Provider: 'openai' (default) or 'local' (no API costs, requires sentence-transformers)
EMBEDDING_PROVIDER=openai

# --- OpenAI embeddings (used when EMBEDDING_PROVIDER=openai) ---
# EMBEDDING_MODEL=text-embedding-3-small   # default – do not change unless you know why
# EMBEDDING_DIMENSION=1536                 # must match the model above

# --- Local embeddings (used when EMBEDDING_PROVIDER=local) ---
# Uncomment the two lines below and set EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL_LOCAL=all-MiniLM-L6-v2
# EMBEDDING_DIMENSION=384

EMBEDDING_BATCH_SIZE=32

# Prefect
PREFECT_API_URL=http://localhost:4200/api
PREFECT_API_KEY=

# Crawling Configuration
CRAWL_USER_AGENT=PostHarvestBot/1.0 (+https://fourlanes.tech/bot)
CRAWL_DELAY_SECONDS=2.0
CRAWL_MAX_DEPTH=4
CRAWL_TIMEOUT_SECONDS=30
CRAWL_MAX_RETRIES=3

# Content Processing
RELEVANCE_THRESHOLD=6.0
MIN_CONTENT_LENGTH=100
MAX_CONTENT_LENGTH=50000
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Site-Specific Settings
NARO_ENABLED=true
AGRICULTURE_ENABLED=true
EXTENSION_ENABLED=true
UBOS_ENABLED=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/scraper.log
LOG_ROTATION=10 MB
LOG_RETENTION=30 days

# Admin Dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
ADMIN_JWT_SECRET=  # generate with: openssl rand -hex 32

# Development
DEBUG=false
ENVIRONMENT=development
# ── Translation (Sunbird AI) ──────────────────────────────────────────────────
# Enables bidirectional translation for Ugandan local languages in the dashboard.
# Supported languages: Luganda (lug), Acholi (ach), Runyankole (nyn),
#                      Ateso (teo), Lugbara (lgg)
# Get an API key at https://sunbird.ai
# If SUNBIRD_API_KEY is empty, translation is automatically disabled (no network calls).
SUNBIRD_API_KEY=your_sunbird_api_key_here
SUNBIRD_API_URL=https://api.sunbird.ai
TRANSLATION_ENABLED=true
# Minimum confidence score (0–1) for language detection to trigger translation.
# Inputs below this threshold are treated as English.
TRANSLATION_MIN_CONFIDENCE=0.80

# BertScore
BERTSCORE_ENABLED=true
BERTSCORE_MODEL=distilbert-base-uncased
